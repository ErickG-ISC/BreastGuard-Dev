# Copiar a .env (en la raíz del repo) para desarrollo local.
# En Render/Railway, definir estas mismas variables en el panel de Environment.

# Cadena de conexión de Supabase (Project Settings > Database > Connection string).
# IMPORTANTE: usa la pestaña "Session pooler", NO "Direct connection" — la conexión directa
# de Supabase solo resuelve por IPv6, y hosts como Render/Railway/Vercel no tienen salida IPv6
# (falla con "Network is unreachable"). El pooler sí soporta IPv4.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:tu_password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clave usada para firmar los JWT. Generar una aleatoria, p. ej.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Supabase Storage, para subir las imágenes (Project Settings > API)
# SUPABASE_KEY debe ser la "service_role" key (permisos completos) — solo se usa en el backend, nunca la expongas al frontend.
# Crea el bucket con este nombre en Storage antes de desplegar (Storage > New bucket).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=
SUPABASE_BUCKET=medical-images

# Origen(es) del frontend permitidos por CORS, separados por coma
FRONTEND_ORIGIN=http://localhost:5173,https://tu-app.vercel.app

# Ruta al modelo .h5 (opcional, por defecto "models/breast_cancer_model.h5")
MODEL_PATH=models/breast_cancer_model.h5

# Tamaño máximo de imagen subida, en MB (opcional, por defecto 10)
MAX_UPLOAD_MB=10

# Las pruebas (pytest) no leen este archivo: usan el Postgres local de docker-compose
# (TEST_DATABASE_URL) y un doble de Storage.

# --- Multitenencia con RLS (ADR 0002 y 0003) ---
# DATABASE_URL (arriba) es el rol DUEÑO: solo lo usan Alembic y los scripts de mantenimiento.
# La app se conecta SIEMPRE como app_user: toma host/puerto/base de DATABASE_URL, cambia el usuario
# "postgres.<ref>" por "<APP_DB_USER>.<ref>" y usa APP_DB_PASSWORD. Nunca usa la contraseña del dueño.
# En Render, DATABASE_URL puede ir SIN contraseña.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_DB_PASSWORD=
# Opcional: nombre del rol de la app (por defecto app_user)
# APP_DB_USER=app_user
# Opcional: URL completa de app_user que sustituye a la derivada
# APP_DATABASE_URL=
