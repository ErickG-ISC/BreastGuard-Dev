# Copia este archivo a backend/.env y completa los valores reales.
# NO subas backend/.env al repo (ya está en .gitignore).

# --- Base de datos (RDS) ---
DATABASE_URL=postgresql://admin:TU_PASSWORD@TU-ENDPOINT-RDS.rds.amazonaws.com:5432/breast_cancer_db

# --- JWT ---
SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui

# --- CORS ---
# Dominio/IP pública desde donde se sirve el frontend. Varios separados por coma.
ALLOWED_ORIGINS=http://TU-IP-PUBLICA-EC2

# --- Almacenamiento de imágenes ---
# local -> guarda en disco de la EC2 (LOCAL_STORAGE_DIR). s3 -> sube al bucket S3.
STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=/home/ubuntu/breastguard-uploads
LOCAL_STORAGE_PUBLIC_BASE=/uploads

# Solo se usan si STORAGE_BACKEND=s3. En AWS Academy usa las credenciales temporales
# del panel "AWS Details" del Learner Lab (incluyen AWS_SESSION_TOKEN, obligatorio;
# caducan y hay que actualizarlas cada vez que reinicias el Learner Lab).
S3_BUCKET_NAME=tu-bucket-breastguard
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
